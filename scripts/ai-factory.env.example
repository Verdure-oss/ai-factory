# ai-factory 配置文件（示例）
# 使用前请复制为 ai-factory.env 并填写真实值：
#   cp ai-factory.env.example ai-factory.env
#   vim ai-factory.env
# 然后运行 ./update-config.sh 即可热更新（无需重启 Pod）

# ============================================================
# 敏感凭证（存入 K8s Secret）
# ============================================================

# GitHub Personal Access Token（需要 repo 权限）
GITHUB_TOKEN=

# Webhook 签名密钥（与 GitHub Webhook 配置中的 Secret 一致）
WEBHOOK_SECRET=

# OpenAI / 兼容 API 的密钥
OPENAI_API_KEY=

# Codex CLI 密钥（可选）
CODEX_API_KEY=

# GitLab Token（gitlab 模式必填，需要 api 权限）
GITLAB_TOKEN=

# ============================================================
# 提供商选择（必填）
# ============================================================

# 当前 server 实例服务的代码托管方：github 或 gitlab。必填，不设启动报错。
# 一个实例只服务一个提供商：GitHub 部署在公网、GitLab 部署在内网，分开部署。
GIT_PROVIDER=

# GitLab API 基址（可选，仅 gitlab 模式）。留空则从 issue/project 的 host
# 自动推导为 https://<host>/api/v4，适配自建实例。仅在需要覆盖时填写。
GITLAB_API_BASE=

# ============================================================
# 模型配置（存入 K8s ConfigMap）
# ============================================================

# OpenAI 兼容 API 地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称
OPENAI_MODEL=gpt-4.1

# 以下参数控制沙箱内 coding-agent 的三段式执行：
#   tool-exploration(探索/干活) -> final-script(只出脚本) -> repair(失败修复)
# 三段各有用到 round 上限和请求超时，调整时注意取舍（见各参数注释）。

# 温度参数（0~2，默认 1）
# 作用：随机性/发散度。三段式每次请求都带。
# 注意：本 agent 任务要求 "只输出可运行的 POSIX shell 脚本"，温度越高越容易
#       偏离格式（输出分析文字 / 包 Markdown / 擅自调工具），触发无效重试。
# 建议：偏向确定性/严格改造任务 -> 0.2~0.4；创意/设计型任务 -> 0.7~1。
OPENAI_TEMPERATURE=1

# 单次模型响应的最大输出 token 数
# 注意：这是 "每次生成的上限"，不是上下文窗口（1M 上下文是输入+输出的总预算，
#       两者互不影响）。且不能超过模型实际支持的 completion 上限，设太大 API
#       会拒绝或被截断。
# 注意：被截断（finish_reason=length）会被判为无效响应并触发重试，设太小会
#       浪费 final-script 轮数。
# 建议：简单任务 512~4096；复杂任务设到所用模型的上限即可，不必追求大。
OPENAI_MAX_TOKENS=48000

# Agent 执行轮次限制
# OPENAI_MAX_TOOL_ROUNDS：tool-exploration 阶段最多调多少次模型。
#   每轮 = 一次模型调用 + 执行 Shell 工具，是最烧钱/最耗时的一环。
#   建议：简单 bug 修复 10~20；复杂跨文件重构 40~60。太小会探索不足、脚本质量差。
OPENAI_MAX_TOOL_ROUNDS=40
# OPENAI_MAX_FINAL_SCRIPT_ROUNDS：final-script 阶段最多重试几次（= 上轮输出无效）。
#   只有在模型经常产出无效响应（仍调工具/被截断/纯分析）时才需调大（如 8）。
OPENAI_MAX_FINAL_SCRIPT_ROUNDS=5
# OPENAI_MAX_REPAIR_ROUNDS：脚本运行失败后，最多让模型出几次修复脚本。
#   这是复杂任务成功率的关键兜底。注意：repair 频繁触发说明脚本本身质量差，
#   根源多在温度太高或 tool 轮数不足，别只靠调大 repair 掩盖。
#   建议：复杂/环境易错任务调到 5~6；稳定任务保持 3。
OPENAI_MAX_REPAIR_ROUNDS=3

# 超时配置（秒）
# OPENAI_TOTAL_TIMEOUT_SECONDS：整个 agent 一次运行的全局截止时间，所有阶段共享。
OPENAI_TOTAL_TIMEOUT_SECONDS=1800
# 以下为各阶段单次 HTTP 请求超时，会被 "总剩余时间" 截断（取较小值）。
OPENAI_EXPLORATION_REQUEST_TIMEOUT_SECONDS=180
OPENAI_FINAL_REQUEST_TIMEOUT_SECONDS=90
OPENAI_REPAIR_REQUEST_TIMEOUT_SECONDS=90

# 是否启用 issue 图片输入（多模态）
# true：从 issue 中提取图片 URL 并作为 image_url 内容块传给模型，模型能真正"看到"截图。
# false：退回纯文本逻辑，图片 URL 仅作为文本留在 prompt 里（模型看不到图）。
# 注意：开启需要所用模型支持视觉输入。
OPENAI_VISION_ENABLED=true

# Git 代理（可选，格式: http://proxy:port）
# 留空或不设置则不使用代理
AI_FACTORY_GIT_PROXY=

# ============================================================
# Fork PR 工作流（可选，仅 GitHub）
# ============================================================
# 场景：目标仓库是公共仓库（你无写权限），需要"推送到自己的 fork，向上游提 PR"。
# 配置后，ai-factory 会克隆你的 fork、同步上游，然后从 fork:branch 向上游:base 建 PR。

# Fork 的所有者（GitHub 用户名）。留空则自动从 token 反查登录名。
# 当事件仓库的 owner 与 fork owner 相同时，自动保持直连流程（不用 fork）。
GITHUB_FORK_OWNER=

# 仓库 allow-list（可选）：只允许这些 owner/repo 触发 FactoryTask，逗号分隔。
# 留空 = 不限制（所有仓库都能触发）。安全加固用。
GITHUB_REPOSITORY_ALLOWLIST=
