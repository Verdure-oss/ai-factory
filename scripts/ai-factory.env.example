# ai-factory 配置文件（示例）
# 使用前请复制为 ai-factory.env 并填写真实值：
#   cp ai-factory.env.example ai-factory.env
#   vim ai-factory.env
# 然后运行 ./update-config.sh 即可热更新（无需重启 Pod）

# ============================================================
# 敏感凭证（存入 K8s Secret）
# ============================================================

# GitHub Personal Access Token（需要 repo 权限）
GITHUB_TOKEN=

# Webhook 签名密钥（与 GitHub Webhook 配置中的 Secret 一致）
WEBHOOK_SECRET=

# OpenAI / 兼容 API 的密钥
OPENAI_API_KEY=

# Codex CLI 密钥（可选）
CODEX_API_KEY=

# GitLab Token（可选，使用 GitLab 时填写）
GITLAB_TOKEN=

# ============================================================
# 模型配置（存入 K8s ConfigMap）
# ============================================================

# OpenAI 兼容 API 地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称
OPENAI_MODEL=gpt-4.1

# 温度参数
OPENAI_TEMPERATURE=1

# 最大 token 数
OPENAI_MAX_TOKENS=48000

# Agent 执行轮次限制
OPENAI_MAX_TOOL_ROUNDS=40
OPENAI_MAX_FINAL_SCRIPT_ROUNDS=5
OPENAI_MAX_REPAIR_ROUNDS=3

# 超时配置（秒）
OPENAI_TOTAL_TIMEOUT_SECONDS=1800
OPENAI_EXPLORATION_REQUEST_TIMEOUT_SECONDS=180
OPENAI_FINAL_REQUEST_TIMEOUT_SECONDS=90
OPENAI_REPAIR_REQUEST_TIMEOUT_SECONDS=90

# Git 代理（可选，格式: http://proxy:port）
# 留空或不设置则不使用代理
# AI_FACTORY_GIT_PROXY=
