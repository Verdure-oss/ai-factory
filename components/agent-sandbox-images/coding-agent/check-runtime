set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_LAUNCHER="${SCRIPT_DIR}/ai-factory-agent"
PYTHON_AGENT="${SCRIPT_DIR}/ai-factory-agent.py"
AGENT_BUDGET="${SCRIPT_DIR}/agent_budget.py"
AGENT_CONFIG="${SCRIPT_DIR}/agent_config.py"
REPAIR_LOOP="${SCRIPT_DIR}/repair_loop.py"
REPAIR_PROMPT="${SCRIPT_DIR}/repair_prompt.py"
SCRIPT_VALIDATION="${SCRIPT_DIR}/script_validation.py"

bash -n "${RUNTIME_LAUNCHER}"
grep -Fq 'ai-factory-agent.py' "${RUNTIME_LAUNCHER}"

python3 - "${PYTHON_AGENT}" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY

python3 - "${SCRIPT_VALIDATION}" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY

python3 - "${AGENT_BUDGET}" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY

python3 - "${AGENT_CONFIG}" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY

python3 - "${REPAIR_LOOP}" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY

python3 - "${REPAIR_PROMPT}" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY

PYTHONPATH="${SCRIPT_DIR}" python3 "${SCRIPT_DIR}/script_validation_test.py"
PYTHONPATH="${SCRIPT_DIR}" python3 "${SCRIPT_DIR}/agent_budget_test.py"
PYTHONPATH="${SCRIPT_DIR}" python3 "${SCRIPT_DIR}/agent_config_test.py"
PYTHONPATH="${SCRIPT_DIR}" python3 "${SCRIPT_DIR}/agent_integration_test.py"
PYTHONPATH="${SCRIPT_DIR}" python3 "${SCRIPT_DIR}/repair_prompt_test.py"
PYTHONPATH="${SCRIPT_DIR}" python3 "${SCRIPT_DIR}/repair_loop_test.py"

bash "${RUNTIME_LAUNCHER}" --help >/dev/null
env -i \
  PATH="${PATH}" \
  PYTHONDONTWRITEBYTECODE=1 \
  OPENAI_API_KEY=check-runtime-placeholder \
  bash "${RUNTIME_LAUNCHER}" openai-compatible --check-config \
  || { echo "check-runtime: --check-config failed for default configuration" >&2; exit 1; }

# Codex delegated dispatch: with a stub `codex` on PATH, verify the launcher
# builds `codex exec --dangerously-bypass-approvals-and-sandbox [--model X] "<prompt>"`
# with the prompt as the last positional argument.
CODEX_TEST_DIR="$(mktemp -d)"
trap 'rm -rf "${CODEX_TEST_DIR}"' EXIT
cat > "${CODEX_TEST_DIR}/codex" <<STUB
#!/usr/bin/env bash
printf '%s\n' "\$@" > "${CODEX_TEST_DIR}/args.txt"
printf '%s' "\${!#}" > "${CODEX_TEST_DIR}/last_arg.txt"
STUB
chmod +x "${CODEX_TEST_DIR}/codex"
printf 'TASK-INSTRUCTIONS-MARKER\n' | \
  PATH="${CODEX_TEST_DIR}:${PATH}" \
  AI_FACTORY_SKILL_FILE="${CODEX_TEST_DIR}/nonexistent-skill.md" \
  AI_FACTORY_WORKDIR="${CODEX_TEST_DIR}" \
  CODEX_MODEL=check-runtime-model \
  bash "${RUNTIME_LAUNCHER}" codex \
  || { echo "check-runtime: codex dispatch exited non-zero" >&2; exit 1; }
CODEX_ARGS="$(cat "${CODEX_TEST_DIR}/args.txt")"
grep -Fxq 'exec' "${CODEX_TEST_DIR}/args.txt" \
  || { echo "check-runtime: codex args missing 'exec': ${CODEX_ARGS}" >&2; exit 1; }
grep -Fxq -- '--dangerously-bypass-approvals-and-sandbox' "${CODEX_TEST_DIR}/args.txt" \
  || { echo "check-runtime: codex args missing bypass flag: ${CODEX_ARGS}" >&2; exit 1; }
grep -Fxq -- '--model' "${CODEX_TEST_DIR}/args.txt" \
  || { echo "check-runtime: codex args missing --model: ${CODEX_ARGS}" >&2; exit 1; }
grep -Fxq 'check-runtime-model' "${CODEX_TEST_DIR}/args.txt" \
  || { echo "check-runtime: codex args missing model value: ${CODEX_ARGS}" >&2; exit 1; }
grep -Fq 'TASK-INSTRUCTIONS-MARKER' "${CODEX_TEST_DIR}/last_arg.txt" \
  || { echo "check-runtime: codex prompt not passed as last argument" >&2; exit 1; }
echo "coding-agent runtime checks passed"
