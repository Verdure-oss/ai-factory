set -euo pipefail

# SandboxTemplate commands may override the image entrypoint. Normalize the
# toolchain path in the actual agent launcher so every child shell inherits it.
export PATH="/usr/local/go/bin:${PATH:-}"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_AGENT="${SCRIPT_DIR}/ai-factory-agent.py"

# Codex delegated mode: the workflow "skill" is loaded from outside the image
# (K8s ConfigMap mount) with an in-image default as fallback. Overridable.
CODEX_SKILL_FILE="${AI_FACTORY_SKILL_FILE:-/opt/ai-factory/skills/issue-fix/SKILL.md}"
CODEX_WORKDIR="${AI_FACTORY_WORKDIR:-/workspace/repo}"

usage() {
    cat >&2 <<'EOF'
Usage:
  ai-factory-agent openai-compatible [--check-config]
  ai-factory-agent codex [extra codex args...]
  ai-factory-agent --help

OpenAI-compatible mode reads the FactoryTask prompt from stdin and executes a
model-generated shell script in the current repository.

Codex (delegated) mode reads the FactoryTask prompt from stdin and runs the
pre-installed Codex CLI (`codex exec`) in the repository checkout. Codex follows
an externally loaded workflow skill (default
/opt/ai-factory/skills/issue-fix/SKILL.md) to fix the issue, run checks locally,
commit, push, and open a PR/MR itself. It prints a final
`__AI_FACTORY_RESULT__={...}` line the controller reads for the PR URL.

  --check-config   Validate the OpenAI-compatible configuration offline and
                   exit without reading a prompt or making a network request.

Required environment:
  OPENAI_API_KEY   (openai-compatible mode)

Codex mode environment:
  CODEX_HOME               default: /home/agent/.codex (holds auth.json/config.toml)
  CODEX_MODEL              optional model override passed as `codex exec --model`
                           and used as the generated config.toml model
  CODEX_WIRE_API           default: responses (Codex >=0.130 removed "chat");
                           set to "chat" only for gateways lacking /v1/responses
  AI_FACTORY_CODEX_SKIP_CONFIG  set non-empty to skip config.toml generation and
                           keep the default ChatGPT/auth.json login path
  AI_FACTORY_SKILL_FILE    default: /opt/ai-factory/skills/issue-fix/SKILL.md
  AI_FACTORY_WORKDIR       default: /workspace/repo

Third-party model (no auth.json): when OPENAI_BASE_URL points at an
OpenAI-compatible gateway (not api.openai.com) and OPENAI_API_KEY is set, codex
mode auto-generates $CODEX_HOME/config.toml from OPENAI_BASE_URL / OPENAI_API_KEY
/ (CODEX_MODEL or OPENAI_MODEL), so Codex uses that gateway instead of OpenAI.

Optional environment:
  OPENAI_BASE_URL      default: https://api.openai.com/v1
  OPENAI_MODEL         default: gpt-4.1
  OPENAI_TEMPERATURE   default: 1
  OPENAI_MAX_TOKENS    default: 48000
  OPENAI_MAX_TOOL_ROUNDS default: 40
  OPENAI_MAX_FINAL_SCRIPT_ROUNDS default: 5
  OPENAI_MAX_REPAIR_ROUNDS default: 3
  OPENAI_TOTAL_TIMEOUT_SECONDS default: 1800
  OPENAI_EXPLORATION_REQUEST_TIMEOUT_SECONDS default: 180
  OPENAI_FINAL_REQUEST_TIMEOUT_SECONDS default: 90
  OPENAI_REPAIR_REQUEST_TIMEOUT_SECONDS default: 90
EOF
}

run_openai_compatible() {
    local check_config=false
    for arg in "$@"; do
        if [[ "$arg" == "--check-config" ]]; then
            check_config=true
        fi
    done

    if [[ ! -f "${PYTHON_AGENT}" ]]; then
        echo "ai-factory-agent.py is required beside the runtime launcher" >&2
        return 1
    fi

    if [[ "${check_config}" == "true" ]]; then
        python3 "${PYTHON_AGENT}" --check-config
        return $?
    fi

    prompt_file="$(mktemp)"
    trap 'rm -f "${prompt_file}"' RETURN
    cat > "${prompt_file}"
    AI_FACTORY_PROMPT_FILE="${prompt_file}" python3 "${PYTHON_AGENT}" "$@"
}

# Mask known secret values in Codex output before it reaches stdout/logs. Codex
# is a general agent and may echo tokens; the controller captures this stream.
redact_secrets() {
    local sed_args=() name val esc
    for name in OPENAI_API_KEY CODEX_API_KEY GITHUB_TOKEN GITLAB_TOKEN AI_FACTORY_GITHUB_TOKEN; do
        val="${!name:-}"
        if [[ -n "${val}" ]]; then
            esc="$(printf '%s' "${val}" | sed -e 's/[&/\]/\\&/g')"
            sed_args+=(-e "s/${esc}/<redacted:${name}>/g")
        fi
    done
    if [[ ${#sed_args[@]} -eq 0 ]]; then
        cat
    else
        sed -u "${sed_args[@]}" 2>/dev/null || sed "${sed_args[@]}"
    fi
}

# Build the Codex prompt: point it at the workflow skill, note the injected
# task-context env vars, then hand it the FactoryTask instructions verbatim.
compose_codex_prompt() {
    local task="$1" skill="$2"
    if [[ -f "${skill}" ]]; then
        printf 'Read and strictly follow the workflow skill at %s. It is the authoritative playbook for this task: fix the issue, run the relevant checks locally, commit, push, and open a PR/MR yourself, then print the required result line.\n\n' "${skill}"
    else
        echo "ai-factory: workflow skill ${skill} not found; proceeding with task instructions only" >&2
    fi
    printf 'Task context is available in these environment variables: AI_FACTORY_REPO, AI_FACTORY_BASE_REF, AI_FACTORY_BRANCH, AI_FACTORY_ISSUE_URL, AI_FACTORY_PR_TITLE, AI_FACTORY_PR_BODY, AI_FACTORY_REMOTE, AI_FACTORY_PROVIDER. Git auth (GITHUB_TOKEN/GITLAB_TOKEN) is already in the environment.\n\n'
    printf 'When finished, print exactly one final line: __AI_FACTORY_RESULT__={"pr_url":"<url>","branch":"<branch>","summary":"<one sentence>"} and nothing after it.\n\n'
    printf '%s\n' "${task}"
}

# Point Codex at a third-party OpenAI-compatible gateway by generating a
# config.toml from the same env the openai-compatible mode already uses
# (OPENAI_BASE_URL / OPENAI_API_KEY / model). This lets Codex run without a
# ChatGPT auth.json and without ever contacting api.openai.com.
#
# Generation is skipped (leaving the default ChatGPT/auth.json behavior intact)
# when any of the following holds:
#   - AI_FACTORY_CODEX_SKIP_CONFIG is set to a non-empty value
#   - OPENAI_API_KEY or OPENAI_BASE_URL is empty
#   - OPENAI_BASE_URL still points at api.openai.com (the official endpoint)
#   - $CODEX_HOME/config.toml already exists but was NOT written by us (i.e. an
#     operator supplied their own config; it lacks our managed marker) -- we
#     respect it and never overwrite it. A config carrying our marker (written
#     on a previous run in a reused warm pod) is safely regenerated.
CODEX_CONFIG_MARKER="# ai-factory: managed codex config, do not edit"

maybe_write_codex_config() {
    local codex_home="${CODEX_HOME:-${HOME}/.codex}"
    local config="${codex_home}/config.toml"

    if [[ -n "${AI_FACTORY_CODEX_SKIP_CONFIG:-}" ]]; then
        return 0
    fi
    if [[ -z "${OPENAI_API_KEY:-}" || -z "${OPENAI_BASE_URL:-}" ]]; then
        return 0
    fi
    # Only rewrite requests away from the official OpenAI endpoint; the default
    # base URL keeps the ChatGPT-account (auth.json) login path.
    local host="${OPENAI_BASE_URL#*://}"
    host="${host%%/*}"
    host="${host%%:*}"
    if [[ "${host}" == "api.openai.com" ]]; then
        return 0
    fi
    # Respect an operator-provided config.toml (one we did not write ourselves).
    if [[ -e "${config}" ]] && ! head -n 1 "${config}" 2>/dev/null | grep -qF "${CODEX_CONFIG_MARKER}"; then
        echo "ai-factory: existing operator ${config} found; leaving it as-is" >&2
        return 0
    fi

    local model="${CODEX_MODEL:-${OPENAI_MODEL:-}}"
    local wire_api="${CODEX_WIRE_API:-responses}"

    mkdir -p "${codex_home}"
    {
        printf '%s\n' "${CODEX_CONFIG_MARKER}"
        printf 'model = "%s"\n' "${model}"
        printf 'model_provider = "aifactory"\n'
        printf '\n'
        printf '[model_providers.aifactory]\n'
        printf 'name = "AI Factory Gateway"\n'
        printf 'base_url = "%s"\n' "${OPENAI_BASE_URL}"
        printf 'env_key = "OPENAI_API_KEY"\n'
        printf 'wire_api = "%s"\n' "${wire_api}"
    } > "${config}"

    # Log endpoint/model for diagnostics; never the API key.
    echo "ai-factory: codex config.toml -> base_url=${OPENAI_BASE_URL} model=${model:-<from OPENAI_MODEL>} wire_api=${wire_api}" >&2
}

# Delegated mode: run the pre-installed Codex CLI against the checkout. The
# workflow (edit -> local CI -> commit -> push -> open PR) lives in the skill,
# not here; this function only prepares and launches the engine.
run_codex() {
    if ! command -v codex >/dev/null 2>&1; then
        echo "codex CLI not found in sandbox image; delegated mode requires it" >&2
        return 127
    fi

    maybe_write_codex_config

    local prompt_body
    prompt_body="$(cat)"
    if [[ -z "${prompt_body//[[:space:]]/}" ]]; then
        echo "FactoryTask prompt on stdin is empty" >&2
        return 2
    fi

    local full_prompt
    full_prompt="$(compose_codex_prompt "${prompt_body}" "${CODEX_SKILL_FILE}")"

    if [[ -d "${CODEX_WORKDIR}" ]]; then
        cd "${CODEX_WORKDIR}"
    else
        echo "ai-factory: workdir ${CODEX_WORKDIR} not found; running codex in ${PWD}" >&2
    fi

    # Assemble `codex exec [--dangerously-bypass-approvals-and-sandbox] [--model X] <extra> "<prompt>"`.
    # The pod is already isolated, so Codex's own sandbox/approval must be off or
    # it cannot write files, use gh/glab, or reach the network.
    local codex_args=() arg has_exec=false has_bypass=false
    for arg in "$@"; do
        [[ "${arg}" == "exec" ]] && has_exec=true
        [[ "${arg}" == "--dangerously-bypass-approvals-and-sandbox" ]] && has_bypass=true
    done
    if [[ "${has_exec}" == "false" ]]; then
        codex_args+=("exec")
    fi
    if [[ "${has_bypass}" == "false" ]]; then
        codex_args+=("--dangerously-bypass-approvals-and-sandbox")
    fi
    if [[ -n "${CODEX_MODEL:-}" ]]; then
        codex_args+=("--model" "${CODEX_MODEL}")
    fi
    codex_args+=("$@")
    codex_args+=("${full_prompt}")

    # Stream output but mask secrets first; preserve codex's exit code.
    set +e
    codex "${codex_args[@]}" 2>&1 | redact_secrets
    local status="${PIPESTATUS[0]}"
    set -e
    return "${status}"
}

case "${1:-}" in
    openai-compatible)
        shift
        run_openai_compatible "$@"
        exit $?
        ;;
    codex)
        shift
        run_codex "$@"
        exit $?
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
esac

if [[ -n "${OPENAI_API_KEY:-}" ]]; then
    run_openai_compatible "$@"
    exit $?
fi

echo "No agent command selected. Set AGENT_COMMAND/spec.agent.command, or provide OPENAI_API_KEY for openai-compatible mode." >&2
exit 127
